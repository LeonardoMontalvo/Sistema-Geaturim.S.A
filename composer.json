{
    "name": "geaturim/sistema-web",
    "description": "Sistema de Gestión Empresarial Geaturim S.A.",
    "type": "project",
    "require": {
        "php": ">=7.4",
        "phpoffice/phpspreadsheet": "^5.1",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "Geaturim\\": "src/"
        },
        "files": [
            "procesos/config.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
