# ===================================
# CONFIGURACIÓN DEL SISTEMA GEATURIM
# ===================================
# Copie este archivo a .env y configure con sus valores reales
# IMPORTANTE: Nunca commita el archivo .env al repositorio

# -----------------------------------
# BASE DE DATOS PRINCIPAL
# -----------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=syswebfe
DB_USER=postgres
DB_PASSWORD=Leonardo2.0

# -----------------------------------
# BASE DE DATOS ALTERNATIVA (Inventario Antiguo)
# -----------------------------------
DB_ALT_HOST=localhost
DB_ALT_PORT=5432
DB_ALT_NAME=syswebfe_inven_ant
DB_ALT_USER=postgres
DB_ALT_PASSWORD=Leonardo2.0

# -----------------------------------
# CONFIGURACIÓN DE LA APLICACIÓN
# -----------------------------------
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=America/Guayaquil

# -----------------------------------
# SEGURIDAD
# -----------------------------------
# Lista de esquemas permitidos (separados por coma)
ALLOWED_SCHEMAS=public,schema1,schema2

# Clave para encriptación (generar con: php -r "echo bin2hex(random_bytes(32));")
APP_KEY=

# -----------------------------------
# SESIONES
# -----------------------------------
SESSION_LIFETIME=7200
SESSION_SECURE=false
SESSION_HTTPONLY=true
SESSION_SAMESITE=Lax

# -----------------------------------
# OPCIONES DE DESARROLLO
# -----------------------------------
# Mostrar errores de PHP (solo en desarrollo)
DISPLAY_ERRORS=false
ERROR_REPORTING=E_ALL

# Log de errores
LOG_ERRORS=true
ERROR_LOG_PATH=/var/log/geaturim/errors.log
